<%
const { utils, route, config, routes } = it;
const { requestBodyInfo, responseBodyInfo, specificArgNameResolver } = route;
const { _, getInlineParseContent, getParseContent, parseSchema, getComponentByRef, require } = utils;
const { parameters, path, method, payload, query, formData, security, requestParams } = route.request;
const { type, errorType, contentTypes } = route.response;
const { raw, request, routeName } = route;
const { HTTP_CLIENT, RESERVED_REQ_PARAMS_ARG_NAMES } = config.constants;
const routeDocs = includeFile("./route-docs", { config, route, utils });
const queryName = (query && query.name) || "query";
const pathParams = _.values(parameters);
const pathParamsNames = _.map(pathParams, "name");

// Load dynamic naming utilities
const namingUtils = includeFile("./naming-utils", { utils });

// Collect all routes for analysis (modular + combined)
const allRoutes = [];
if (routes && routes.combined) {
  routes.combined.forEach(group => {
    if (group.routes) {
      allRoutes.push(...group.routes);
    }
  });
}
if (config.modular && it.route && it.route.routes) {
  allRoutes.push(...it.route.routes);
}

// Get dynamic naming for this route
const routeNaming = namingUtils.getRouteNaming(route, allRoutes, utils);

const hasParams = pathParams.length > 0 || !!query || !!payload;

const isValidIdentifier = (name) => /^[A-Za-z_$][A-Za-z0-9_$]*$/.test(name);

// Use method-specific types instead of original types
const simpleMethodName = routeNaming.methodName;
const inputTypeName = routeNaming.inputTypeName;
const resultTypeName = routeNaming.resultTypeName;
const methodInputType = `Types.${inputTypeName}`;
const methodResultType = `Types.${resultTypeName}`;

// Resolve query parameter names from requestParams metadata
const queryParamNames = [];
if (query && requestParams && requestParams.rawTypeData && requestParams.rawTypeData.properties) {
  Object.values(requestParams.rawTypeData.properties).forEach((prop) => {
    if (prop.in === "query") {
      queryParamNames.push(prop.name);
    }
  });
}

const nonBodyKeys = [...pathParamsNames, ...queryParamNames];
const hasNonBodyKeys = nonBodyKeys.length > 0;
const hasBody = !!payload;
const isUrlEncoded = requestBodyInfo && requestBodyInfo.contentKind === "URL_ENCODED";
const isFormData = requestBodyInfo && requestBodyInfo.contentKind === "FORM_DATA";

// swagger-typescript-api already converts OpenAPI path params to JS template form
// e.g. "/api/plans/tiers/${tierId}" — reuse that instead of raw.route placeholders
const buildUrlPathTemplate = () => {
  if (!hasParams || pathParams.length === 0) {
    return path;
  }

  let urlPath = path;
  pathParams.forEach((param) => {
    urlPath = urlPath.replace(
      "${" + param.name + "}",
      "${resolvedParams." + param.name + "}",
    );
  });
  return urlPath;
};

const urlPathTemplate = buildUrlPathTemplate();
const hasPathParams = pathParams.length > 0;
%>

/**
<%~ routeDocs.description %>

 *<% /* Here you can add some other JSDoc tags */ %>

<%~ routeDocs.lines %>

 * @param host Optional base URL host (e.g., 'https://api.example.com') to override the default relative URL
 */
<% if (isValidIdentifier(simpleMethodName)) { %><%~ simpleMethodName %><% } else { %>"<%~ simpleMethodName %>"<% } %> = <% if (hasParams) { %>(params: Signal<<%~ methodInputType %> | undefined>, host?: string)<% } else { %>(host?: string)<% } %> => {
  return httpResource<% if (methodResultType && methodResultType !== 'void' && methodResultType !== 'any') { %><<%~ methodResultType %>><% } %>(() => {
    <% if (hasParams) { %>
    const resolvedParams = params();
    if (!resolvedParams) return undefined;
    <% } %>

    <% if (hasPathParams) { %>
    const url = host ? `${host}<%~ urlPathTemplate %>` : `<%~ urlPathTemplate %>`;
    <% } else { %>
    const url = host ? `${host}<%~ path %>` : '<%~ path %>';
    <% } %>

    <% if (query && queryParamNames.length > 0) { %>
    const queryParams: Record<string, string> = {};
    <% queryParamNames.forEach((name) => { %>
    if (resolvedParams.<%~ name %> !== undefined && resolvedParams.<%~ name %> !== null) {
      queryParams['<%~ name %>'] = String(resolvedParams.<%~ name %>);
    }
    <% }); %>
    <% } %>

    <% if (hasBody && hasParams) { %>
    <% if (hasNonBodyKeys) { %>
    const bodyPayload = Object.fromEntries(
      Object.entries(resolvedParams).filter(([key]) => !<%~ JSON.stringify(nonBodyKeys) %>.includes(key)),
    );
    <% } else { %>
    const bodyPayload = resolvedParams;
    <% } %>
    <% } %>

    return {
      url,
      method: '<%~ _.upperCase(method) %>',
      <% if (query && queryParamNames.length > 0) { %>
      params: queryParams,
      <% } %>
      <% if (hasBody && hasParams) { %>
      <% if (isUrlEncoded) { %>
      body: new URLSearchParams(
        Object.entries(bodyPayload)
          .filter(([, value]) => value !== undefined && value !== null)
          .map(([key, value]) => [key, String(value)]),
      ),
      <% } else if (isFormData) { %>
      body: (() => {
        const form = new FormData();
        Object.entries(bodyPayload).forEach(([key, value]) => {
          if (value !== undefined && value !== null) {
            form.append(key, value instanceof Blob ? value : String(value));
          }
        });
        return form;
      })(),
      <% } else { %>
      body: bodyPayload,
      <% } %>
      <% } %>
      <% if (requestBodyInfo && (requestBodyInfo.contentType || (requestBodyInfo.contentTypes && requestBodyInfo.contentTypes[0]))) { %>
      headers: {
        'Content-Type': '<%~ requestBodyInfo.contentType || requestBodyInfo.contentTypes[0] %>',
      },
      <% } %>
    };
  });
};
